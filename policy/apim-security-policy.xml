<policies>
    <inbound>
        <base />
        <!-- JWT Validation -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <openid-config url="https://login.microsoftonline.com/2824f499-6503-495b-a70a-19fc9a7cf089/.well-known/openid-configuration" />
            <required-claims>
                <claim name="aud">
                    <value>api://5b7d86e0-c922-407d-af23-1844370c2648</value>
                </claim>
            </required-claims>
        </validate-jwt>
        <!-- Rate Limiting -->
        <rate-limit-by-key calls="20" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
        <!-- Read Request Body -->
        <set-variable name="requestBody" value="@(context.Request.Body.As<string>(preserveContent: true).ToLowerInvariant())" />
        <!-- AI Security Inspection -->
        <choose>
            <!-- Prompt Injection Detection -->
            <when condition="@(((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;ignore previous instructions&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;reveal your system prompt&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;bypass policy&quot;))">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":"Potential prompt injection attempt blocked by AI gateway policy."}</set-body>
                </return-response>
            </when>
            <!-- Sensitive Data / PII Detection -->
            <when condition="@(((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;password&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;private key&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;api key&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;secret&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;credit card&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;social insurance number&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;ssn&quot;))">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":"Sensitive data pattern detected and blocked by AI security gateway."}</set-body>
                </return-response>
            </when>
            <!-- Dangerous Instruction / AI Misuse Detection -->
            <when condition="@(((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;phishing&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;steal token&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;steal password&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;credential theft&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;exfiltrate data&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;disable logging&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;malware&quot;) || ((string)context.Variables[&quot;requestBody&quot;]).Contains(&quot;ransomware&quot;))">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":"Dangerous AI misuse pattern detected and blocked by AI security gateway."}</set-body>
                </return-response>
            </when>
        </choose>
        <!-- Monitoring Headers -->
        <set-header name="x-ai-gateway-security" exists-action="override">
            <value>enabled</value>
        </set-header>
        <set-header name="x-ai-security-layer" exists-action="override">
            <value>apim-ai-security-policy</value>
        </set-header>
        <!-- Backend Authentication -->
        <set-header name="api-key" exists-action="override">
            <value>{{phi4-api-key}}</value>
        </set-header>
        <!-- Gateway Identification -->
        <set-header name="x-gateway-name" exists-action="override">
            <value>apim-ai-security-prod</value>
        </set-header>
        <!-- Model Routing -->
        <set-header name="x-ms-model-mesh-model-name" exists-action="override">
            <value>Phi-4</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
